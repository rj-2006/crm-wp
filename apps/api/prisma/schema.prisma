generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activity_logs {
  log_id     String     @id @db.Uuid
  contact_id String     @db.Uuid
  user_id    String?    @db.Uuid
  action     String
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  company_id String?    @db.Uuid
  companies  companies? @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  contacts   contacts   @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)
  users      users?     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id])
}

model audit_logs {
  audit_log_id String     @id @db.Uuid
  company_id   String?    @db.Uuid
  user_id      String?    @db.Uuid
  entity_type  String
  entity_id    String?    @db.Uuid
  action       String
  changes      Json?
  ip_address   String?
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  companies    companies? @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  users        users?     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id])
  @@index([created_at])
  @@index([entity_type, entity_id], map: "audit_logs_entity_idx")
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model campaign_recipients {
  recipient_id          String                        @id @db.Uuid
  campaign_id           String                        @db.Uuid
  contact_id            String                        @db.Uuid
  status                crm_campaign_recipient_status @default(pending)
  attempts              Int                           @default(0)
  next_retry_at         DateTime?                     @db.Timestamptz(6)
  last_error            String?
  sent_at               DateTime?                     @db.Timestamptz(6)
  delivered_at          DateTime?                     @db.Timestamptz(6)
  read_at               DateTime?                     @db.Timestamptz(6)
  failed_at             DateTime?                     @db.Timestamptz(6)
  last_status_change_at DateTime                      @default(now()) @db.Timestamptz(6)
  campaigns             campaigns                     @relation(fields: [campaign_id], references: [campaign_id], onDelete: NoAction, onUpdate: NoAction)
  contacts              contacts                      @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([campaign_id, contact_id], map: "campaign_recipients_campaign_contact_key")
  @@index([campaign_id])
  @@index([contact_id])
  @@index([next_retry_at])
  @@index([status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model campaigns {
  campaign_id         String                @id @db.Uuid
  name                String
  template_id         String?               @db.Uuid
  status              crm_campaign_status   @default(draft)
  segment_filter      Json?
  company_id          String?               @db.Uuid
  created_by          String?               @db.Uuid
  whatsapp_account_id String?               @db.Uuid
  total_recipients    Int                   @default(0)
  sent_count          Int                   @default(0)
  delivered_count     Int                   @default(0)
  read_count          Int                   @default(0)
  failed_count        Int                   @default(0)
  campaign_recipients campaign_recipients[]
  companies           companies?            @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  users               users?                @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  message_templates   message_templates?    @relation(fields: [template_id], references: [template_id], onDelete: NoAction, onUpdate: NoAction)
  whatsapp_accounts   whatsapp_accounts?    @relation(fields: [whatsapp_account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  messages            messages[]

  @@index([company_id])
  @@index([created_by])
  @@index([status])
  @@index([whatsapp_account_id])
}

model companies {
  company_id        String              @id @db.Uuid
  name              String
  industry          String?
  activity_logs     activity_logs[]
  audit_logs        audit_logs[]
  campaigns         campaigns[]
  consent_logs      consent_logs[]
  contacts          contacts[]
  follow_ups        follow_ups[]
  leads             leads[]
  message_templates message_templates[]
  tags              tags[]
  users             users[]
  whatsapp_accounts whatsapp_accounts[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model consent_logs {
  consent_log_id String     @id @db.Uuid
  company_id     String?    @db.Uuid
  contact_id     String     @db.Uuid
  action         String
  source         String?
  reason         String?
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  companies      companies? @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  contacts       contacts   @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id])
  @@index([contact_id])
  @@index([created_at])
}

model contact_tags {
  contact_id String   @db.Uuid
  tag_id     String   @db.Uuid
  contacts   contacts @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)
  tags       tags     @relation(fields: [tag_id], references: [tag_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([contact_id, tag_id])
}

model contacts {
  contact_id          String                @id @db.Uuid
  name                String
  phone               String
  company_id          String                @db.Uuid
  consent_status      crm_consent_status    @default(unknown)
  last_inbound_at     DateTime?             @db.Timestamptz(6)
  consent_source      String?
  consent_updated_at  DateTime?             @db.Timestamptz(6)
  activity_logs       activity_logs[]
  campaign_recipients campaign_recipients[]
  consent_logs        consent_logs[]
  contact_tags        contact_tags[]
  companies           companies             @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  follow_ups          follow_ups[]
  leads               leads[]
  messages            messages[]

  @@unique([company_id, phone], map: "contacts_company_phone_key")
  @@index([company_id, consent_status], map: "contacts_company_consent_status_idx")
  @@index([company_id])
}

model follow_ups {
  follow_up_id String     @id @db.Uuid
  contact_id   String     @db.Uuid
  assigned_to  String?    @db.Uuid
  due_date     DateTime?  @db.Date
  notes        String?
  company_id   String?    @db.Uuid
  users        users?     @relation(fields: [assigned_to], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  companies    companies? @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  contacts     contacts   @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assigned_to])
  @@index([company_id])
  @@index([contact_id])
}

model leads {
  lead_id    String     @id @db.Uuid
  contact_id String     @db.Uuid
  stage      String?
  source     String?
  company_id String?    @db.Uuid
  companies  companies? @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  contacts   contacts   @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id])
  @@index([contact_id])
}

model message_templates {
  template_id          String                       @id @db.Uuid
  name                 String
  provider_template_id String?
  category             crm_template_category?
  approval_status      crm_template_approval_status @default(pending)
  company_id           String?                      @db.Uuid
  language             String?
  structure_payload    Json?
  synced_at            DateTime?                    @db.Timestamptz(6)
  campaigns            campaigns[]
  companies            companies?                   @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  messages             messages[]

  @@index([company_id])
}

model messages {
  message_id          String                @id @db.Uuid
  contact_id          String                @db.Uuid
  campaign_id         String?               @db.Uuid
  template_id         String?               @db.Uuid
  provider_message_id String?               @unique
  status              crm_message_status    @default(pending)
  whatsapp_account_id String?               @db.Uuid
  direction           crm_message_direction @default(outbound)
  from_number         String?
  to_number           String?
  error_code          String?
  error_message       String?
  failed_at           DateTime?             @db.Timestamptz(6)
  campaigns           campaigns?            @relation(fields: [campaign_id], references: [campaign_id], onDelete: NoAction, onUpdate: NoAction)
  contacts            contacts              @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)
  message_templates   message_templates?    @relation(fields: [template_id], references: [template_id], onDelete: NoAction, onUpdate: NoAction)
  whatsapp_accounts   whatsapp_accounts?    @relation(fields: [whatsapp_account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  webhook_events      webhook_events[]

  @@index([campaign_id])
  @@index([contact_id])
  @@index([status])
  @@index([template_id])
  @@index([whatsapp_account_id])
}

model tags {
  tag_id       String         @id @db.Uuid
  name         String
  company_id   String?        @db.Uuid
  contact_tags contact_tags[]
  companies    companies?     @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([company_id, name], map: "tags_company_name_key")
  @@index([company_id])
}

model users {
  user_id           String              @id @db.Uuid
  name              String
  email             String              @unique
  password_hash     String
  role              crm_user_role       @default(staff)
  company_id        String?             @db.Uuid
  activity_logs     activity_logs[]
  audit_logs        audit_logs[]
  campaigns         campaigns[]
  follow_ups        follow_ups[]
  companies         companies?          @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  whatsapp_accounts whatsapp_accounts[]

  @@index([company_id])
}

model webhook_events {
  event_id            String             @id @db.Uuid
  dedupe_key          String             @unique
  message_id          String?            @db.Uuid
  type                String
  raw_payload         Json?
  received_at         DateTime           @default(now()) @db.Timestamptz(6)
  whatsapp_account_id String?            @db.Uuid
  messages            messages?          @relation(fields: [message_id], references: [message_id], onDelete: NoAction, onUpdate: NoAction)
  whatsapp_accounts   whatsapp_accounts? @relation(fields: [whatsapp_account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([message_id])
  @@index([whatsapp_account_id])
}

model whatsapp_accounts {
  account_id          String           @id @db.Uuid
  phone_number_id     String           @unique
  business_account_id String?
  credentials_ref     String?
  company_id          String?          @db.Uuid
  owner_user_id       String?          @db.Uuid
  name                String?
  is_active           Boolean          @default(true)
  campaigns           campaigns[]
  messages            messages[]
  webhook_events      webhook_events[]
  companies           companies?       @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction)
  users               users?           @relation(fields: [owner_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id])
  @@index([owner_user_id])
}

enum crm_campaign_recipient_status {
  pending
  queued
  sent
  delivered
  read
  failed
}

enum crm_campaign_status {
  draft
  scheduled
  running
  completed
  cancelled
}

enum crm_consent_status {
  unknown
  opted_in
  opted_out
}

enum crm_message_direction {
  inbound
  outbound
}

enum crm_message_status {
  pending
  sent
  delivered
  read
  failed_retryable
  failed_permanent
}

enum crm_template_approval_status {
  pending
  approved
  rejected
}

enum crm_template_category {
  marketing
  utility
  authentication
}

enum crm_user_role {
  staff
  admin
}
